{
    "name": "kore-ui",
    "version": "2.2.0",
    "description": "Frontend assets for koreUi - Laravel UI component library",
    "main": "resources/js/index.js",
    "license": "MIT",
    "scripts": {
        "build": "vite build && vite build --config vite.editor.config.js",
        "dev": "vite build --watch",
        "size": "node scripts/bundle-size.mjs",
        "dist:check": "node scripts/dist-sync.mjs",
        "test:js": "vitest run",
        "test:js:watch": "vitest",
        "markdown:check": "node scripts/markdown-paridad.mjs"
    },
    "dependencies": {
        "@alpinejs/collapse": "^3.15.8",
        "@floating-ui/dom": "^1.7.6"
    },
    "devDependencies": {
        "acorn": "^8.17.0",
        "alpinejs": "^3.15.12",
        "jsdom": "^29.1.1",
        "vite": "^6.0.0",
        "vitest": "^2.1.9"
    }
}
